@model Hospital_Management_System.Models.Patient

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="PatientId" />
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

    <div class="form-group">
        <label asp-for="PatientFirstName"></label>
        <input asp-for="PatientFirstName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="PatientLastName"></label>
        <input asp-for="PatientLastName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="PatientDateOfBirth"></label>
        <input asp-for="PatientDateOfBirth" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="PatientAddress"></label>
        <input asp-for="PatientAddress" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="PatientPhoneNumber"></label>
        <input asp-for="PatientPhoneNumber" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="PatientEmail"></label>
        <input asp-for="PatientEmail" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="PatientEmergencyContactName"></label>
        <input asp-for="PatientEmergencyContactName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="PatientEmergencyContactPhoneNumber"></label>
        <input asp-for="PatientEmergencyContactPhoneNumber" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="AssignedDoctorId"></label>
        <input asp-for="AssignedDoctorId" class="form-control" />
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">
            Save Changes
        </button>
    </div>
</form>
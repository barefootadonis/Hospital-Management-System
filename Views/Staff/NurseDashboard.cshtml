@model Hospital_Management_System.Models.Staff

@{
    ViewData["Title"] = "Nurse Dashboard";
}

<div class="page">

    <h2>Welcome @Model.StaffFirstName</h2>
    <p>Staff ID: @Model.StaffId</p>
    <p>Role: Nurse</p>

    <div class="grid">

        <div class="card">
            <h3>Work Calendar</h3>
            <p>View appointments, meetings and work events.</p>

            <a asp-action="Calendar"
                   asp-route-id="@Model.StaffId"
                   asp-route-userType="Staff"
                   class="btn btn-secondary">
                Open Calendar
            </a>
        </div>

        <div class="card">
            <h3>Quick Actions</h3>

            <div class="quick-actions-grid">

                <a asp-action="VitalsMenu" asp-route-id="@Model.StaffId" class="btn btn-primary">
                    Patient Vitals
                </a>

                <a asp-action="MyTickets" asp-route-id="@Model.StaffId" class="btn btn-secondary">
                    Ticket Manager
                </a>

            </div>
        </div>

    </div>

</div>
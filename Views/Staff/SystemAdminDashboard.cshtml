@{
    ViewData["Title"] = "System Admin Dashboard";
}

@model Hospital_Management_System.Models.Staff

<div class="page">

    <h2>Welcome @Model.StaffFirstName</h2>
    <p>Staff ID: @Model.StaffId</p>
    <p>Role: System Administrator</p>

    <div class="grid">

        <div class="card">
            <h3>Work Calendar</h3>
            <p>View appointments, meetings and work events.</p>

            <a asp-action="Calendar"
                   asp-route-id="@Model.StaffId"
                   asp-route-userType="Staff"
                   class="btn btn-secondary">
                Open Calendar
            </a>
        </div>

        <div class="card">
            <h3>Quick Actions</h3>

            <div class="quick-actions-grid mt-3">

                <a asp-action="DatabaseOptions" method="get" class="btn btn-primary">
                    Edit Database
                </a>

                <a asp-action="MyTickets" asp-route-id="@Model.StaffId" class="btn btn-secondary">
                    Ticket Manager
                </a>

                <a asp-action="SystemStats" class="btn btn-secondary">
                    System Stats
                </a>

                <a asp-action="DeactivateAccounts" class="btn btn-primary">
                    Deactivated Accounts
                </a>

            </div>
        </div>

    </div>

</div>
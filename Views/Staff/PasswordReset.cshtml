@model List<Hospital_Management_System.Models.UserAccount>

@{
    ViewData["Title"] = "Password Manager";
}

<div class="page">
    <div class="card">
        <h2>Password Manager</h2>
        <p>Review staff and patient accounts that may need a password reset.</p>

        @if (Model.Any())
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Last Changed</th>
                        <th>Days Left</th>
                        <th>Status</th>
                        <th>Reset Password</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in Model)
                    {
                        var daysSinceChange = (DateTime.Now - account.PasswordLastChanged).Days;
                        var daysLeft = 90 - daysSinceChange;

                        string userName = account.Staff != null
                            ? account.Staff.StaffFirstName + " " + account.Staff.StaffLastName
                            : account.Patient != null
                                ? account.Patient.PatientFirstName + " " + account.Patient.PatientLastName
                                : account.Email;

                        <tr>
                            <td>@userName</td>
                            <td>@account.Role</td>
                            <td>@account.PasswordLastChanged.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (daysLeft <= 0)
                                {
                                    <span>Due now</span>
                                }
                                else
                                {
                                    <span>@daysLeft days</span>
                                }
                            </td>
                            <td>
                                @if (daysLeft <= 0)
                                {
                                    <span class="text-danger fw-bold">Reset required</span>
                                }
                                else if (daysLeft <= 14)
                                {
                                    <span class="text-warning fw-bold">Due soon</span>
                                }
                                else
                                {
                                    <span class="text-success fw-bold">OK</span>
                                }
                            </td>
                            <td>
                                <form asp-action="ResetPassword" method="post" class="reset-password-form">
                                    <input type="hidden" name="accountId" value="@account.AccountId" />

                                    <input type="password"
                                           name="newPassword"
                                           placeholder="Temporary password"
                                           autocomplete="new-password"
                                           required />

                                    <button type="submit" class="btn btn-primary btn-sm">
                                        Reset
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No accounts are due for password reset.</p>
        }
    </div>
</div>
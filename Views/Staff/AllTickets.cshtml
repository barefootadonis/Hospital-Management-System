@model List<Hospital_Management_System.Models.Ticket>

<div class="page">
    <div class="card">
        <h2>Tickets</h2>

        <div class="lookup-header">
            <input type="text" id="ticketSearch" placeholder="Search tickets..." autocomplete="off" />
        </div>
    </div>

    <div class="card">
        <h3>All Tickets</h3>

        @if (Model.Any())
        {
            <table class="table" id="ticketTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Subject</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Sender</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>@t.TicketId</td>
                            <td>@t.Subject</td>
                            <td>@t.Priority</td>
                            <td>@t.Status</td>
                            <td>@t.SenderRole - @t.SenderId</td>
                            <td>@t.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <p id="noTicketResults" style="display:none;">No matching tickets found.</p>
        }
        else
        {
            <p>No tickets found.</p>
        }
    </div>
</div>

<script>
    const ticketSearch = document.getElementById("ticketSearch");
    const ticketRows = document.querySelectorAll("#ticketTable tbody tr");
    const noTicketResults = document.getElementById("noTicketResults");

    ticketSearch.addEventListener("keyup", function () {
        const searchValue = this.value.toLowerCase();
        let visibleCount = 0;

        ticketRows.forEach(row => {
            const rowText = row.innerText.toLowerCase();
            if (rowText.includes(searchValue)) {
                row.style.display = "";
                visibleCount++;
            } else {
                row.style.display = "none";
            }
        });

        noTicketResults.style.display = visibleCount === 0 ? "block" : "none";
    });
</script>
@model List<Hospital_Management_System.Models.PatientTimelineViewModel>

<div class="page">
    <div class="card">
        <h3>Patient Timeline</h3>

        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Record ID</th>
                    <th>Doctor ID</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Date.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @if (item.Type == "Visit")
                            {
                                <span class="badge bg-success">Visit</span>
                            }
                            else if (item.Type == "Diagnosis")
                            {
                                <span class="badge bg-warning text-dark">Diagnosis</span>
                            }
                            else if (item.Type == "Prescription")
                            {
                                <span class="badge bg-primary">Prescription</span>
                            }
                        </td>
                        <td>@item.RecordId</td>
                        <td>@item.DoctorId</td>
                        <td>@item.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
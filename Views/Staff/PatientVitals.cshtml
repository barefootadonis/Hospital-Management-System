@model List<Hospital_Management_System.Models.Vitals>

<div class="page">
    <div class="card">
        <h3>Vitals</h3>

        <table class="table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Temp</th>
                    <th>BP</th>
                    <th>HR</th>
                    <th>Resp</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td>@v.RecordedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@v.Temperature</td>
                        <td>@v.BloodPressure</td>
                        <td>@v.HeartRate</td>
                        <td>@v.RespiratoryRate</td>
                        <td>@v.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@model Hospital_Management_System.Models.Staff

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="StaffId" />
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

    <div class="form-group">
        <label asp-for="StaffFirstName"></label>
        <input asp-for="StaffFirstName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="StaffLastName"></label>
        <input asp-for="StaffLastName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="StaffRole"></label>
        <select asp-for="StaffRole" class="form-control">
            <option>Doctor</option>
            <option>Nurse</option>
            <option>Receptionist</option>
            <option>System Administrator</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="StaffDateOfBirth"></label>
        <input asp-for="StaffDateOfBirth" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="StaffAddress"></label>
        <input asp-for="StaffAddress" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="StaffPhoneNumber"></label>
        <input asp-for="StaffPhoneNumber" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="StaffEmail"></label>
        <input asp-for="StaffEmail" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="StaffEmergencyContactName"></label>
        <input asp-for="StaffEmergencyContactName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="StaffEmergencyContactPhoneNumber"></label>
        <input asp-for="StaffEmergencyContactPhoneNumber" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="ActiveStatus"></label>
        <input asp-for="ActiveStatus" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="StartDate"></label>
        <input asp-for="StartDate" type="date" class="form-control" />
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">
            Save Changes
        </button>
    </div>
</form>

<hr />

@if (Model.ActiveStatus == "Active")
{
    <form asp-action="Deactivate" method="post">
        <input type="hidden" name="id" value="@Model.StaffId" />

        <button type="submit"
                class="btn btn-danger"
                onclick="return confirm('Are you sure you want to deactivate this staff member?');">
            Deactivate Staff
        </button>
    </form>
}
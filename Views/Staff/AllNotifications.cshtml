@model List<Hospital_Management_System.Models.Notification>

<div class="page">
    <div class="card">
        <h2>Notifications</h2>

        <div class="lookup-header">
            <input type="text" id="notificationSearch" placeholder="Search notifications..." autocomplete="off" />
        </div>
    </div>

    <div class="card">
        <h3>All Notifications</h3>

        @if (Model.Any())
        {
            <table class="table" id="notificationTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Message</th>
                        <th>Sender</th>
                        <th>Receiver</th>
                        <th>Read</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var n in Model)
                    {
                        <tr>
                            <td>@n.NotificationId</td>
                            <td>@n.Title</td>
                            <td>@n.Message</td>
                            <td>@n.SenderType - @n.SenderId</td>
                            <td>@n.ReceiverType @n.ReceiverId</td>
                            <td>@(n.IsRead ? "Yes" : "No")</td>
                            <td>@n.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <p id="noNotificationResults" style="display:none;">No matching notifications found.</p>
        }
        else
        {
            <p>No notifications found.</p>
        }
    </div>
</div>

<script>
    const notificationSearch = document.getElementById("notificationSearch");
    const notificationRows = document.querySelectorAll("#notificationTable tbody tr");
    const noNotificationResults = document.getElementById("noNotificationResults");

    notificationSearch.addEventListener("keyup", function () {
        const searchValue = this.value.toLowerCase();
        let visibleCount = 0;

        notificationRows.forEach(row => {
            const rowText = row.innerText.toLowerCase();
            if (rowText.includes(searchValue)) {
                row.style.display = "";
                visibleCount++;
            } else {
                row.style.display = "none";
            }
        });

        noNotificationResults.style.display = visibleCount === 0 ? "block" : "none";
    });
</script>
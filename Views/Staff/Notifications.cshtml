@model List<Hospital_Management_System.Models.Notification>

<div class="page">
    <div class="card">
        <h2>Notifications</h2>

        @if (ViewBag.UserType == "Staff")
        {
            <div class="mb-3 d-flex gap-2">
                <a asp-action="SendMessage"
                       asp-route-id="@ViewBag.CurrentUserId"
                       class="btn btn-primary">
                    Send Message
                </a>

                <a asp-action="SentMessages"
                       asp-route-id="@ViewBag.CurrentUserId"
                       class="btn btn-secondary">
                    Sent Messages
                </a>
            </div>
        }
    </div>

    <div class="card">
        @if (Model.Any())
        {
            @foreach (var notification in Model)
            {
                <details class="notification-item @(notification.IsRead ? "" : "unread-notification")"
                         onclick="markAsRead('@notification.NotificationId', this)">
                    <summary>
                        <span>@notification.SenderType - @notification.SenderId</span>
                        <strong>@notification.Title</strong>
                        <small>@notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                    </summary>

                    <p>@notification.Message</p>
                </details>
            }
        }
        else
        {
            <p>No notifications found.</p>
        }
    </div>
</div>

<script>
    function markAsRead(id, element) {
        if (!element.classList.contains("unread-notification")) return;

        fetch(`/Staff/MarkNotificationRead?id=${id}`)
            .then(() => {
                element.classList.remove("unread-notification");
            });
    }
</script>